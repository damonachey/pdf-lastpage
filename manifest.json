{
  "manifest_version": 3,
  "name": "PDF Last Page",
  "version": "0.1.0",
  "description": "Opens PDFs in the browser and remembers the last page you read.",
  "author": {
    "email": "Damon@Achey.net"
  },
  "minimum_chrome_version": "151",
  "permissions": ["storage"],
  "mime_types_handler": {
    "application/pdf": {
      "handler_url": "pdfjs/web/viewer.html"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PDF Last Page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
